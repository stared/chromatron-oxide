<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chromatron Recompiled</title>
  <meta property="og:title" content="Chromatron Recompiled">
  <meta property="og:description" content="A classic 2002 puzzle game about mirrors and lasers, natively recompiled.">
  <meta property="og:image" content="__SITE_URL__/chromatron_level_3.png">
  <meta name="twitter:card" content="summary_large_image">
  <style>
    :root {
      --bg: #0d0d0d;
      --text: #d4d4d4;
      --accent: #b85cb8;
    }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      max-width: 600px;
      margin: 4rem auto;
      padding: 0 1.5rem;
      line-height: 1.6;
    }
    h1 {
      font-size: 1.5rem;
      font-weight: normal;
      margin-bottom: 0.5rem;
      color: #fff;
    }
    p {
      font-size: 0.9rem;
      margin-top: 0;
    }
    a {
      color: var(--accent);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    
    .header-info {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }

    .play-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.1rem;
      color: var(--accent);
      margin-bottom: 2rem;
    }
    .play-link:hover {
      text-decoration: underline;
    }

    .download-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .download-card {
      padding: 0;
    }
    .dl-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.1rem;
      margin-bottom: 0.3rem;
    }
    .dl-title a {
      color: var(--accent);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .dl-title a:hover {
      text-decoration: underline;
    }
    .dl-icon {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }
    .meta {
      font-size: 0.8rem;
      margin-bottom: 0.5rem;
      word-break: break-all;
    }
    .note {
      font-size: 0.8rem;
      margin-top: 0.5rem;
    }
  </style>
</head>
<body>
  <div class="header-info">
    <h1>Chromatron Recompiled</h1>
    <img src="chromatron_level_3.png" alt="Chromatron Level 3 Screenshot" style="width: 100%; max-width: 480px; display: block; margin: 1.5rem auto;">
    <p>
      Original by Sean Barrett (<a href="https://www.silverspaceship.com/chromatron/">Silver Spaceship Software</a>).<br>
      Recompiled natively by <a href="https://p.migdal.pl/">Piotr Migda&#x142;</a>.<br>
      Read more in: <a href="https://quesma.com/blog/chromatron-recompiled/">blog post</a>
    </p>
  </div>

  <a href="play/" class="play-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    Play in Browser (WASM)
  </a>

  <div class="download-list">
    
    <!-- macOS Apple Silicon -->
    <div class="download-card">
      <div class="dl-title">
        <a href="https://github.com/__DIST_REPO__/releases/latest/download/Chromatron-macos-apple-silicon-unsigned.dmg">
          <svg class="dl-icon" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
          macOS (Apple Silicon)
        </a>
      </div>
      <div class="meta">__DMG_ARM64_SIZE__ &middot; __DMG_ARM64_SHA256__</div>
      <div class="note">If "app is damaged": xattr -cr /Applications/Chromatron.app</div>
    </div>

    <!-- macOS Intel -->
    <div class="download-card">
      <div class="dl-title">
        <a href="https://github.com/__DIST_REPO__/releases/latest/download/Chromatron-macos-intel-unsigned.dmg">
          <svg class="dl-icon" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
          macOS (Intel)
        </a>
      </div>
      <div class="meta">__DMG_X86_64_SIZE__ &middot; __DMG_X86_64_SHA256__</div>
      <div class="note">If "app is damaged": xattr -cr /Applications/Chromatron.app</div>
    </div>

    <!-- Windows -->
    <div class="download-card">
      <div class="dl-title">
        <a href="https://github.com/__DIST_REPO__/releases/latest/download/Chromatron-windows-x86_64.zip">
          <svg class="dl-icon" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
          Windows (x86_64)
        </a>
      </div>
      <div class="meta">__WIN_ZIP_SIZE__ &middot; __WIN_ZIP_SHA256__</div>
      <div class="note">If SmartScreen warns: Click "More info" &rarr; "Run anyway"</div>
    </div>

    <!-- Linux -->
    <div class="download-card">
      <div class="dl-title">
        <a href="https://github.com/__DIST_REPO__/releases/latest/download/Chromatron-linux-x86_64.tar.gz">
          <svg class="dl-icon" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
          Linux (x86_64)
        </a>
      </div>
      <div class="meta">__LINUX_TAR_SIZE__ &middot; __LINUX_TAR_SHA256__</div>
    </div>

  </div>

  <p style="margin-top: 3rem; font-size: 0.8rem; color: var(--muted); border-top: 1px solid #222; padding-top: 1rem;">
    Last build: __BUILD_UTC__
  </p>
</body>
</html>