<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chromatron Recompiled</title>
  <style>
    :root {
      --bg: #0d0d0d;
      --text: #d4d4d4;
      --accent: #b85cb8; /* Softer violet */
      --muted: #777;
      --border: #222;
      --bg-card: #141414;
    }
    body {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      background: var(--bg);
      color: var(--text);
      max-width: 600px;
      margin: 4rem auto;
      padding: 0 1.5rem;
      line-height: 1.6;
    }
    h1 {
      font-size: 1.5rem;
      font-weight: normal;
      margin-bottom: 0.5rem;
      color: #fff;
    }
    p {
      color: var(--muted);
      font-size: 0.9rem;
      margin-top: 0;
    }
    a {
      color: var(--accent);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    
    .header-info {
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }

    .play-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.1rem;
      color: var(--accent);
      margin-bottom: 2rem;
      background: var(--bg-card);
      padding: 0.5rem 1rem;
      border-radius: 4px;
      border: 1px solid var(--border);
    }
    .play-link:hover {
      border-color: var(--accent);
      text-decoration: none;
    }

    .download-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .download-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem;
    }
    .dl-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.1rem;
      font-weight: bold;
      margin-bottom: 0.3rem;
    }
    .dl-title a {
      color: var(--accent);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .dl-title a:hover {
      text-decoration: underline;
    }
    .dl-icon {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }
    .meta {
      font-size: 0.75rem;
      color: var(--muted);
      margin-bottom: 0.5rem;
      font-family: monospace;
    }
    code {
      background: #000;
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
      color: #aaa;
      word-break: break-all;
    }
    .note {
      font-size: 0.8rem;
      color: #aaa;
      background: #1e1e1e;
      padding: 0.5rem 0.75rem;
      border-radius: 4px;
      margin-top: 0.5rem;
      border-left: 2px solid var(--accent);
    }
    .note code {
      color: #fff;
    }
  </style>
</head>
<body>
  <div class="header-info">
    <h1>Chromatron Recompiled</h1>
    <p>
